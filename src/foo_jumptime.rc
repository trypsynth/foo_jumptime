#include <windows.h>
#include "resource.h"

IDD_JUMP_DIALOG DIALOGEX 0, 0, 200, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Jump to Time"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
	LTEXT           "Enter &time:", IDC_STATIC_PROMPT, 7, 7, 186, 12
	EDITTEXT        IDC_TIME_EDIT, 7, 22, 186, 14, ES_AUTOHSCROLL
	DEFPUSHBUTTON   "OK", IDOK, 89, 42, 50, 14
	PUSHBUTTON      "Cancel", IDCANCEL, 143, 42, 50, 14
END
